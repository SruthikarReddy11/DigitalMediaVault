{
  "manifest_version": 3,
  "name": "VaultXMedia - Product Wishlist Saver",
  "version": "1.0.0",
  "description": "1-Click instant product wishlist saver for VaultXMedia. Works with Amazon, Flipkart, Myntra, Ajio, Meesho, and more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to VaultXMedia Wishlist",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.amazon.com/*",
        "*://*.flipkart.com/*",
        "*://*.myntra.com/*",
        "*://*.ajio.com/*",
        "*://*.meesho.com/*",
        "*://*.nykaa.com/*",
        "*://*.tatacliq.com/*",
        "*://*.croma.com/*",
        "*://*.reliancedigital.in/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "storage",
    "cookies",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*/*"
  ]
}
