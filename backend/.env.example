# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres@localhost:5433/personal_library?schema=public

# Security & Session
SESSION_SECRET=dev-insecure-secret-key-change-in-production-min32chars
SESSION_COOKIE_NAME=pdl_session
SESSION_MAX_AGE_DAYS=7
CORS_ORIGIN=http://localhost:5173

# Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=../storage/uploads
MAX_FILE_SIZE_MB=500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# ESPN Cricinfo Live & Fixtures Service
ESPN_CRICINFO_CORE_URL=http://core.espnuk.org/v2/sports/cricket
ESPN_CRICINFO_RSS_URL=https://static.cricinfo.com/rss/livescores.xml

# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"
