datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  ARCHIVE
  OTHER
}

model User {
  id           String        @id @default(uuid())
  name         String
  username     String        @unique
  email        String        @unique
  passwordHash String
  avatarUrl    String?
  securityPin  String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean       @default(false)
  role         Role          @default(USER)
  isActive     Boolean       @default(true)
  mobileNumber String?
  gender       String?
  dob          DateTime?
  country      String?
  state        String?
  district     String?
  village      String?
  pincode      String?
  occupation   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?

  sessions     Session[]
  folders      Folder[]
  files        File[]
  favorites    Favorite[]
  playlists    Playlist[]
  activityLogs ActivityLog[]
  vaultFolders VaultFolder[]
  vaultCells   VaultCell[]
  shareLinks   ShareLink[]
  photoAlbums  PhotoAlbum[]
  calendarEvents    CalendarEvent[]
  calendarReminders CalendarReminder[]
  secureContacts    SecureContact[]
  savedProducts     SavedProduct[]
  productSections   ProductSection[]
  expenses          Expense[]
  bankAccountLinks  BankAccountLink[]
  notes             Note[]
  places            Place[]
  placeReminders    PlaceReminder[]
  tripPlans         TripPlan[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  deviceName String?
  browser    String?
  os         String?
  deviceType String?
  ipAddress  String?
  location   String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")
  files     File[]
  shareLinks ShareLink[]

  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

model File {
  id           String    @id @default(uuid())
  userId       String
  folderId     String?
  originalName String
  storageKey   String
  mimeType     String
  fileType     FileType
  extension    String
  size         BigInt
  checksum     String?
  isSecret     Boolean   @default(false)
  vaultFolderId String?
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  vaultFolder  VaultFolder? @relation(fields: [vaultFolderId], references: [id], onDelete: Cascade)
  music        Music?     @relation("MusicFile")
  coverForMusic Music[]   @relation("MusicCoverArt")
  favorites    Favorite[]
  shareLinks   ShareLink[]
  albumCoverFor PhotoAlbum[] @relation("AlbumCover")
  albumItems   PhotoAlbumItem[]
  calendarAttachments CalendarAttachment[]
  noteAttachments     NoteAttachment[]
  placeFiles          PlaceFile[]
  tripPlanFiles       TripPlanFile[]

  @@index([userId])
  @@index([fileType])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([folderId])
  @@index([vaultFolderId])
  @@index([userId, isSecret])
  @@index([userId, deletedAt])
  @@index([userId, fileType])
  @@map("files")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  fileId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([userId, fileId])
  @@index([userId])
  @@index([fileId])
  @@map("favorites")
}

model Music {
  id             String         @id @default(uuid())
  fileId         String         @unique
  title          String
  artist         String
  album          String?
  albumArtist    String?
  genre          String?
  year           Int?
  trackNumber    Int?
  discNumber     Int?
  duration       Float          @default(0.0)
  coverArtFileId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  file           File           @relation("MusicFile", fields: [fileId], references: [id], onDelete: Cascade)
  coverArtFile   File?          @relation("MusicCoverArt", fields: [coverArtFileId], references: [id], onDelete: SetNull)
  playlistItems  PlaylistItem[]

  @@index([artist])
  @@index([album])
  @@index([genre])
  @@map("music")
}

model Playlist {
  id          String         @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  musicId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  music      Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@unique([playlistId, musicId])
  @@index([playlistId, position])
  @@map("playlist_items")
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model StorageBlob {
  id         String   @id @default(uuid())
  storageKey String   @unique
  userId     String?
  category   String?
  mimeType   String?
  size       BigInt
  data       Bytes
  checksum   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storageKey])
  @@index([userId])
  @@map("storage_blobs")
}

model VaultFolder {
  id           String      @id @default(uuid())
  userId       String
  name         String
  passwordHash String
  description  String?
  color        String?     @default("#3b82f6")
  icon         String?     @default("folder")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cells        VaultCell[]
  files        File[]

  @@index([userId])
  @@map("vault_folders")
}

model VaultCell {
  id        String      @id @default(uuid())
  folderId  String
  userId    String
  title     String
  url       String
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  folder    VaultFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([userId])
  @@map("vault_cells")
}

model ShareLink {
  id            String           @id @default(uuid())
  userId        String
  fileId        String?
  folderId      String?
  albumId       String?
  productId     String?
  productSectionId String?
  token         String           @unique
  title         String?
  passwordHash  String?
  hasPassword   Boolean          @default(false)
  expiresAt     DateTime?
  allowDownload Boolean          @default(true)
  maxDownloads  Int?
  downloadCount Int              @default(0)
  viewCount     Int              @default(0)
  isRevoked     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  file          File?            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder        Folder?          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  album         PhotoAlbum?      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  product       SavedProduct?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSection ProductSection? @relation(fields: [productSectionId], references: [id], onDelete: Cascade)
  accessLogs    ShareAccessLog[]

  @@index([token])
  @@index([userId])
  @@index([fileId])
  @@index([folderId])
  @@index([albumId])
  @@index([productId])
  @@index([productSectionId])
  @@index([expiresAt])
  @@map("share_links")
}

model ShareAccessLog {
  id          String    @id @default(uuid())
  shareLinkId String
  action      String    // VIEW, DOWNLOAD, STREAM
  ipAddress   String?
  userAgent   String?
  fileId      String?
  createdAt   DateTime  @default(now())

  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
  @@index([createdAt])
  @@map("share_access_logs")
}

model PhotoAlbum {
  id          String           @id @default(uuid())
  userId      String
  name        String
  description String?
  coverFileId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverFile   File?            @relation("AlbumCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  items       PhotoAlbumItem[]
  shareLinks  ShareLink[]

  @@index([userId])
  @@map("photo_albums")
}

model PhotoAlbumItem {
  id        String     @id @default(uuid())
  albumId   String
  fileId    String
  addedAt   DateTime   @default(now())

  album     PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  file      File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([albumId, fileId])
  @@index([albumId])
  @@index([fileId])
  @@map("photo_album_items")
}

enum CalendarEventType {
  MEETING
  REMINDER
  TASK
  PERSONAL
  IMPORTANT
  STUDY
  BIRTHDAY
  DEADLINE
  OTHER
}

enum CalendarEventPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
  COMPLETED
}

model CalendarEvent {
  id              String                @id @default(uuid())
  userId          String
  title           String
  description     String?
  type            CalendarEventType     @default(REMINDER)
  priority        CalendarEventPriority @default(NORMAL)
  startTime       DateTime
  endTime         DateTime
  allDay          Boolean               @default(false)
  timezone        String                @default("UTC")
  location        String?
  color           String?
  isImportant     Boolean               @default(false)
  isCompleted     Boolean               @default(false)
  completedAt     DateTime?
  recurrenceRule  String?
  recurrenceEnd   DateTime?
  recurrenceCount Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders       CalendarReminder[]
  checklist       CalendarChecklistItem[]
  attachments     CalendarAttachment[]
  place           Place?                @relation("PlaceCalendarEvent")
  tripPlanEvents  TripPlanEvent[]

  @@index([userId])
  @@index([startTime])
  @@index([endTime])
  @@index([isCompleted])
  @@map("calendar_events")
}

model CalendarReminder {
  id                String         @id @default(uuid())
  eventId           String
  userId            String
  timeOffsetMinutes Int            @default(15)
  triggerTime       DateTime
  status            ReminderStatus @default(PENDING)
  notifiedAt        DateTime?
  createdAt         DateTime       @default(now())

  event             CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([triggerTime])
  @@index([status])
  @@map("calendar_reminders")
}

model CalendarChecklistItem {
  id          String        @id @default(uuid())
  eventId     String
  title       String
  isCompleted Boolean       @default(false)
  position    Int           @default(0)
  createdAt   DateTime      @default(now())

  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("calendar_checklist_items")
}

model CalendarAttachment {
  id        String        @id @default(uuid())
  eventId   String
  fileId    String
  addedAt   DateTime      @default(now())

  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  file      File          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([eventId, fileId])
  @@index([eventId])
  @@index([fileId])
  @@map("calendar_attachments")
}

model SecureContact {
  id          String   @id @default(uuid())
  userId      String
  name        String
  phoneNumber String
  contactType String   @default("Personal")
  occupation  String?
  email       String?
  address     String?
  notes       String?
  isFavorite  Boolean  @default(false)
  color       String?  @default("#06b6d4")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isFavorite])
  @@map("secure_contacts")
}

model SavedProduct {
  id              String    @id @default(uuid())
  userId          String
  url             String
  title           String
  description     String?
  brand           String?
  store           String    @default("Other")
  category        String?   @default("General")
  price           Float?
  originalPrice   Float?
  currency        String    @default("INR")
  currencySymbol  String    @default("₹")
  discountPercent Float?
  targetPrice     Float?
  imageUrl        String?
  additionalImages String[] @default([])
  rating          Float?
  reviewCount     Int?
  inStock         Boolean   @default(true)
  isFavorite      Boolean   @default(false)
  isPurchased     Boolean   @default(false)
  notes           String?
  tags            String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks      ShareLink[]
  sectionItems    ProductSectionItem[]

  @@index([userId])
  @@index([userId, store])
  @@index([userId, isFavorite])
  @@index([userId, category])
  @@map("saved_products")
}

model ProductSection {
  id           String               @id @default(uuid())
  userId       String
  name         String
  description  String?
  color        String?              @default("#6366f1")
  icon         String?              @default("ShoppingBag")
  position     Int                  @default(0)
  isLocked     Boolean              @default(false)
  passwordHash String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        ProductSectionItem[]
  shareLinks   ShareLink[]

  @@index([userId])
  @@index([userId, position])
  @@map("product_sections")
}

model ProductSectionItem {
  id        String         @id @default(uuid())
  sectionId String
  productId String
  position  Int            @default(0)
  addedAt   DateTime       @default(now())

  section   ProductSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product   SavedProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@index([sectionId])
  @@index([productId])
  @@map("product_section_items")
}

enum ExpenseType {
  EXPENSE
  INCOME
}

model Expense {
  id            String           @id @default(uuid())
  userId        String
  type          ExpenseType      @default(EXPENSE)
  amount        Float
  currency      String           @default("INR")
  date          DateTime
  person        String?
  category      String
  description   String?
  reason        String?
  notes         String?
  paymentMethod String           @default("UPI")
  receiptUrl    String?
  tags          String[]         @default([])
  bankTxnId     String?
  bankAccountId String?
  bankName      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount   BankAccountLink? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  placeExpenses PlaceExpense[]
  tripPlanExpenses TripPlanExpense[]

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, category])
  @@index([userId, bankTxnId])
  @@map("expenses")
}

model BankAccountLink {
  id                String    @id @default(uuid())
  userId            String
  provider          String    @default("SETU")
  fipId             String
  bankName          String
  accountNumberMask String
  accountType       String    @default("SAVINGS")
  consentId         String
  consentStatus     String    @default("ACTIVE")
  consentHandle     String?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]

  @@index([userId])
  @@index([userId, consentStatus])
  @@map("bank_account_links")
}

// ============================================================================
// FEATURE 1: SECURE NOTES
// ============================================================================

model Note {
  id                  String           @id @default(uuid())
  userId              String
  title               String
  content             String?          // Plain text / rich text content (null if encrypted)
  isPasswordProtected Boolean          @default(false)
  passwordHash        String?          // bcrypt hash of note password if protected
  encryptedContent    String?          // AES-256-GCM ciphertext
  encryptionIv        String?          // IV
  encryptionTag       String?          // Auth tag
  encryptionSalt      String?          // PBKDF2 salt
  isHidden            Boolean          @default(false)
  isPinned            Boolean          @default(false)
  isArchived          Boolean          @default(false)
  color               String?          @default("#8b5cf6")
  tags                String[]         @default([])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments         NoteAttachment[]
  places              PlaceNote[]
  tripPlans           TripPlanNote[]

  @@index([userId])
  @@index([userId, isHidden])
  @@index([userId, isPinned])
  @@index([userId, isArchived])
  @@map("notes")
}

model NoteAttachment {
  id        String   @id @default(uuid())
  noteId    String
  fileId    String
  addedAt   DateTime @default(now())

  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([noteId, fileId])
  @@index([noteId])
  @@index([fileId])
  @@map("note_attachments")
}

// ============================================================================
// FEATURE 2: PLACES & PLANS
// ============================================================================

enum PlaceStatus {
  WANT_TO_VISIT
  PLANNED
  UPCOMING
  VISITED
  CANCELLED
}

model Place {
  id                String           @id @default(uuid())
  userId            String
  placeId           String?          // Google Place ID (ChIJ...)
  name              String
  address           String?
  city              String?
  state             String?
  country           String?
  latitude          Float?
  longitude         Float?
  googleMapsUrl     String
  category          String?
  rating            Float?
  userRatingsTotal  Int?
  phoneNumber       String?
  website           String?
  openingHours      Json?            // Array of weekday text or hours status
  imageUrl          String?          // Photo URL or proxy path
  photoReference    String?          // Google photo reference
  photoAttributions String[]         @default([]) // HTML attributions required by Google
  notes             String?
  tags              String[]         @default([])
  status            PlaceStatus      @default(WANT_TO_VISIT)
  reminderDate      DateTime?
  reminderTime      String?          // e.g. "14:30"
  reminderOption    String?          // EXACT, ONE_DAY_BEFORE, ONE_WEEK_BEFORE, ONE_MONTH_BEFORE, CUSTOM
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  visitedAt         DateTime?

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders         PlaceReminder[]
  notesLinks        PlaceNote[]
  calendarEventId   String?          @unique
  calendarEvent     CalendarEvent?   @relation("PlaceCalendarEvent", fields: [calendarEventId], references: [id], onDelete: SetNull)
  tripPlans         TripPlanPlace[]
  files             PlaceFile[]
  expenses          PlaceExpense[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, reminderDate])
  @@map("places")
}

model PlaceReminder {
  id              String         @id @default(uuid())
  placeId         String
  userId          String
  triggerTime     DateTime
  reminderOption  String         @default("EXACT")
  status          ReminderStatus @default(PENDING)
  notifiedAt      DateTime?
  createdAt       DateTime       @default(now())

  place           Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([placeId])
  @@index([triggerTime])
  @@index([status])
  @@map("place_reminders")
}

model PlaceNote {
  id        String   @id @default(uuid())
  placeId   String
  noteId    String
  createdAt DateTime @default(now())

  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([placeId, noteId])
  @@index([placeId])
  @@index([noteId])
  @@map("place_notes")
}

model PlaceFile {
  id        String   @id @default(uuid())
  placeId   String
  fileId    String
  createdAt DateTime @default(now())

  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([placeId, fileId])
  @@index([placeId])
  @@index([fileId])
  @@map("place_files")
}

model PlaceExpense {
  id        String   @id @default(uuid())
  placeId   String
  expenseId String
  createdAt DateTime @default(now())

  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([placeId, expenseId])
  @@index([placeId])
  @@index([expenseId])
  @@map("place_expenses")
}

model TripPlan {
  id          String            @id @default(uuid())
  userId      String
  name        String            // e.g. "Japan Trip"
  description String?
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  coverImage  String?
  color       String?           @default("#ec4899")
  status      String            @default("PLANNING")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  places      TripPlanPlace[]
  notes       TripPlanNote[]
  files       TripPlanFile[]
  expenses    TripPlanExpense[]
  events      TripPlanEvent[]

  @@index([userId])
  @@map("trip_plans")
}

model TripPlanPlace {
  id         String   @id @default(uuid())
  tripPlanId String
  placeId    String
  position   Int      @default(0)
  dayNumber  Int?
  notes      String?
  createdAt  DateTime @default(now())

  tripPlan   TripPlan @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([tripPlanId, placeId])
  @@index([tripPlanId])
  @@index([placeId])
  @@map("trip_plan_places")
}

model TripPlanNote {
  id         String   @id @default(uuid())
  tripPlanId String
  noteId     String
  createdAt  DateTime @default(now())

  tripPlan   TripPlan @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([tripPlanId, noteId])
  @@index([tripPlanId])
  @@index([noteId])
  @@map("trip_plan_notes")
}

model TripPlanFile {
  id         String   @id @default(uuid())
  tripPlanId String
  fileId     String
  createdAt  DateTime @default(now())

  tripPlan   TripPlan @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([tripPlanId, fileId])
  @@index([tripPlanId])
  @@index([fileId])
  @@map("trip_plan_files")
}

model TripPlanExpense {
  id         String   @id @default(uuid())
  tripPlanId String
  expenseId  String
  createdAt  DateTime @default(now())

  tripPlan   TripPlan @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([tripPlanId, expenseId])
  @@index([tripPlanId])
  @@index([expenseId])
  @@map("trip_plan_expenses")
}

model TripPlanEvent {
  id         String        @id @default(uuid())
  tripPlanId String
  eventId    String
  createdAt  DateTime      @default(now())

  tripPlan   TripPlan      @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  event      CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([tripPlanId, eventId])
  @@index([tripPlanId])
  @@index([eventId])
  @@map("trip_plan_events")
}

