datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  ARCHIVE
  OTHER
}

model User {
  id           String        @id @default(uuid())
  name         String
  username     String        @unique
  email        String        @unique
  passwordHash String
  avatarUrl    String?
  securityPin  String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean       @default(false)
  role         Role          @default(USER)
  isActive     Boolean       @default(true)
  mobileNumber String?
  gender       String?
  dob          DateTime?
  country      String?
  state        String?
  district     String?
  village      String?
  pincode      String?
  occupation   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?

  sessions     Session[]
  folders      Folder[]
  files        File[]
  favorites    Favorite[]
  playlists    Playlist[]
  activityLogs ActivityLog[]
  vaultFolders VaultFolder[]
  vaultCells   VaultCell[]
  shareLinks   ShareLink[]
  photoAlbums  PhotoAlbum[]
  calendarEvents    CalendarEvent[]
  calendarReminders CalendarReminder[]
  secureContacts    SecureContact[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  deviceName String?
  browser    String?
  os         String?
  deviceType String?
  ipAddress  String?
  location   String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")
  files     File[]
  shareLinks ShareLink[]

  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

model File {
  id           String    @id @default(uuid())
  userId       String
  folderId     String?
  originalName String
  storageKey   String
  mimeType     String
  fileType     FileType
  extension    String
  size         BigInt
  checksum     String?
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  music        Music?     @relation("MusicFile")
  coverForMusic Music[]   @relation("MusicCoverArt")
  favorites    Favorite[]
  shareLinks   ShareLink[]
  albumCoverFor PhotoAlbum[] @relation("AlbumCover")
  albumItems   PhotoAlbumItem[]
  calendarAttachments CalendarAttachment[]

  @@index([userId])
  @@index([fileType])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([folderId])
  @@index([userId, deletedAt])
  @@index([userId, fileType])
  @@map("files")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  fileId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([userId, fileId])
  @@index([userId])
  @@index([fileId])
  @@map("favorites")
}

model Music {
  id             String         @id @default(uuid())
  fileId         String         @unique
  title          String
  artist         String
  album          String?
  albumArtist    String?
  genre          String?
  year           Int?
  trackNumber    Int?
  discNumber     Int?
  duration       Float          @default(0.0)
  coverArtFileId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  file           File           @relation("MusicFile", fields: [fileId], references: [id], onDelete: Cascade)
  coverArtFile   File?          @relation("MusicCoverArt", fields: [coverArtFileId], references: [id], onDelete: SetNull)
  playlistItems  PlaylistItem[]

  @@index([artist])
  @@index([album])
  @@index([genre])
  @@map("music")
}

model Playlist {
  id          String         @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  musicId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  music      Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@unique([playlistId, musicId])
  @@index([playlistId, position])
  @@map("playlist_items")
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model StorageBlob {
  id         String   @id @default(uuid())
  storageKey String   @unique
  userId     String?
  category   String?
  mimeType   String?
  size       BigInt
  data       Bytes
  checksum   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storageKey])
  @@index([userId])
  @@map("storage_blobs")
}

model VaultFolder {
  id           String      @id @default(uuid())
  userId       String
  name         String
  passwordHash String
  description  String?
  color        String?     @default("#3b82f6")
  icon         String?     @default("folder")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cells        VaultCell[]

  @@index([userId])
  @@map("vault_folders")
}

model VaultCell {
  id        String      @id @default(uuid())
  folderId  String
  userId    String
  title     String
  url       String
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  folder    VaultFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([userId])
  @@map("vault_cells")
}

model ShareLink {
  id            String           @id @default(uuid())
  userId        String
  fileId        String?
  folderId      String?
  albumId       String?
  token         String           @unique
  title         String?
  passwordHash  String?
  hasPassword   Boolean          @default(false)
  expiresAt     DateTime?
  allowDownload Boolean          @default(true)
  maxDownloads  Int?
  downloadCount Int              @default(0)
  viewCount     Int              @default(0)
  isRevoked     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  file          File?            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder        Folder?          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  album         PhotoAlbum?      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  accessLogs    ShareAccessLog[]

  @@index([token])
  @@index([userId])
  @@index([fileId])
  @@index([folderId])
  @@index([albumId])
  @@index([expiresAt])
  @@map("share_links")
}

model ShareAccessLog {
  id          String    @id @default(uuid())
  shareLinkId String
  action      String    // VIEW, DOWNLOAD, STREAM
  ipAddress   String?
  userAgent   String?
  fileId      String?
  createdAt   DateTime  @default(now())

  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
  @@index([createdAt])
  @@map("share_access_logs")
}

model PhotoAlbum {
  id          String           @id @default(uuid())
  userId      String
  name        String
  description String?
  coverFileId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverFile   File?            @relation("AlbumCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  items       PhotoAlbumItem[]
  shareLinks  ShareLink[]

  @@index([userId])
  @@map("photo_albums")
}

model PhotoAlbumItem {
  id        String     @id @default(uuid())
  albumId   String
  fileId    String
  addedAt   DateTime   @default(now())

  album     PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  file      File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([albumId, fileId])
  @@index([albumId])
  @@index([fileId])
  @@map("photo_album_items")
}

enum CalendarEventType {
  MEETING
  REMINDER
  TASK
  PERSONAL
  IMPORTANT
  STUDY
  BIRTHDAY
  DEADLINE
  OTHER
}

enum CalendarEventPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
  COMPLETED
}

model CalendarEvent {
  id              String                @id @default(uuid())
  userId          String
  title           String
  description     String?
  type            CalendarEventType     @default(REMINDER)
  priority        CalendarEventPriority @default(NORMAL)
  startTime       DateTime
  endTime         DateTime
  allDay          Boolean               @default(false)
  timezone        String                @default("UTC")
  location        String?
  color           String?
  isImportant     Boolean               @default(false)
  isCompleted     Boolean               @default(false)
  completedAt     DateTime?
  recurrenceRule  String?
  recurrenceEnd   DateTime?
  recurrenceCount Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders       CalendarReminder[]
  checklist       CalendarChecklistItem[]
  attachments     CalendarAttachment[]

  @@index([userId])
  @@index([startTime])
  @@index([endTime])
  @@index([isCompleted])
  @@map("calendar_events")
}

model CalendarReminder {
  id                String         @id @default(uuid())
  eventId           String
  userId            String
  timeOffsetMinutes Int            @default(15)
  triggerTime       DateTime
  status            ReminderStatus @default(PENDING)
  notifiedAt        DateTime?
  createdAt         DateTime       @default(now())

  event             CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([triggerTime])
  @@index([status])
  @@map("calendar_reminders")
}

model CalendarChecklistItem {
  id          String        @id @default(uuid())
  eventId     String
  title       String
  isCompleted Boolean       @default(false)
  position    Int           @default(0)
  createdAt   DateTime      @default(now())

  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("calendar_checklist_items")
}

model CalendarAttachment {
  id        String        @id @default(uuid())
  eventId   String
  fileId    String
  addedAt   DateTime      @default(now())

  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  file      File          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([eventId, fileId])
  @@index([eventId])
  @@index([fileId])
  @@map("calendar_attachments")
}

model SecureContact {
  id          String   @id @default(uuid())
  userId      String
  name        String
  phoneNumber String
  contactType String   @default("Personal")
  occupation  String?
  email       String?
  address     String?
  notes       String?
  isFavorite  Boolean  @default(false)
  color       String?  @default("#06b6d4")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isFavorite])
  @@map("secure_contacts")
}




